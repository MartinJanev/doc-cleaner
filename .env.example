# Copy to .env and adjust. Every variable is prefixed with DOCPIPE_.
# The values below are the built-in defaults from docpipe/core/config.py —
# uncommenting one without changing it is a no-op.

# --- Filesystem -------------------------------------------------------------
DOCPIPE_INPUT_DIR=docpipe/data/input
DOCPIPE_OUTPUT_DIR=docpipe/data/output
DOCPIPE_STATE_FILE=.pipeline_state.json

# --- Ollama / LLM -----------------------------------------------------------
DOCPIPE_OLLAMA_HOST=http://localhost:11434

# The model must be pulled first: `ollama pull qwen2.5:14b`.
# Other models that handle cleanup + JSON metadata well:
#   qwen2.5:7b        strong JSON, lighter RAM (good on 8 GB machines)
#   mistral-nemo:12b  strong mid-size alternative
#   llama3.1:8b       solid, similar RAM to qwen2.5:7b
DOCPIPE_MODEL_TAG=qwen2.5:14b

# Characters of Markdown sent to the metadata pass (and to the single-pass
# clean+analyze call for small documents).
DOCPIPE_LLM_MAX_CHARS=12000

# Documents larger than this are cleaned chunk by chunk instead of in one call.
# Raising it REQUIRES raising DOCPIPE_LLM_NUM_CTX too — see below.
DOCPIPE_LLM_CHUNK_CHARS=8000

# Token context window requested from Ollama. It must fit one chunk plus the
# cleaned version the model echoes back (~1 token per 4 characters, so budget
# roughly DOCPIPE_LLM_CHUNK_CHARS / 2 tokens). Too small = silently truncated
# output; the app refuses to start if the two are obviously incompatible.
DOCPIPE_LLM_NUM_CTX=8192

DOCPIPE_LLM_TIMEOUT_S=300
DOCPIPE_LLM_TEMPERATURE=0.1

# --- Concurrency / watcher --------------------------------------------------
# Keep this at 1 unless you have RAM to spare: Docling and Ollama are both
# memory-hungry and share the machine.
DOCPIPE_MAX_WORKERS=1
DOCPIPE_DEBOUNCE_SECONDS=2.0
DOCPIPE_MAX_ATTEMPTS=3
DOCPIPE_SUPPORTED_SUFFIXES=.pdf,.docx

# --- Comparison -------------------------------------------------------------
# Keep Docling's raw extraction alongside the refined output and score how much
# the model changed it. `docpipe compare` reports the results. Turning this off
# also stops the raw Markdown being written, since nothing else reads it.
DOCPIPE_COMPARE_ENABLED=true

# Seconds between comparison sweeps while the daemon is running.
DOCPIPE_COMPARE_INTERVAL_S=60.0

# --- Web interface ----------------------------------------------------------
# Served alongside the watcher by `python -m docpipe.main`.
DOCPIPE_WEB_ENABLED=true
# The UI is unauthenticated by design. Keep it on loopback unless you have
# read SECURITY.md and understand the trade-off.
DOCPIPE_WEB_HOST=127.0.0.1
DOCPIPE_WEB_PORT=8000
DOCPIPE_WEB_MAX_UPLOAD_MB=200

# --- Logging ----------------------------------------------------------------
DOCPIPE_LOG_LEVEL=INFO
# true = one JSON object per line (for log shippers); false = colourized console.
DOCPIPE_LOG_JSON=true
